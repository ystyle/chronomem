{
  "name": "dsh-mem-bridge",
  "version": "0.1.0",
  "description": "dsh host plugin: automatically record session activity into 忆时塔 (chronomem) — zero-LLM structure layer plus pre-distilled turn/compaction summaries.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./pure": "./lib/pure.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "memory",
    "chronomem"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://atomgit.com/ystyle/chronomem.git",
    "directory": "dsh-mem-bridge"
  },
  "homepage": "https://atomgit.com/ystyle/chronomem/tree/master/dsh-mem-bridge",
  "bugs": {
    "url": "https://atomgit.com/ystyle/chronomem/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
